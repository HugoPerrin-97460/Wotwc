{%- comment -%}
  Vue JSON de la recherche, utilisée par la section « Recherche par liste ».
  Appel : /search?q=Lightning+Bolt&type=product&view=deck
{%- endcomment -%}
{%- layout none -%}
{%- paginate search.results by 50 -%}
{"products":[
{%- assign first = true -%}
{%- for p in search.results -%}
  {%- if p.object_type == 'product' -%}
    {%- unless first -%},{%- endunless -%}
    {%- assign first = false -%}
    {"id":{{ p.id }},"title":{{ p.title | json }},"url":{{ p.url | json }},
    "image":{% if p.featured_image %}{{ p.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},
    "variants":[
    {%- for v in p.variants -%}
      {"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"available":{{ v.available }},
      "qty":{% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %}}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    ]}
  {%- endif -%}
{%- endfor -%}
]}
{%- endpaginate -%}
